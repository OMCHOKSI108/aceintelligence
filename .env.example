# Botpress Webchat Configuration
NEXT_PUBLIC_BOTPRESS_INJECT_URL=https://cdn.botpress.cloud/webchat/vX.X/inject.js
NEXT_PUBLIC_BOTPRESS_CONFIG_URL=https://files.bpcontent.cloud/XXXXX/config.js

# Database (Neon pooled connection string with ?sslmode=require)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth
JWT_SECRET=generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=7d
SEED_SECRET=generate-with-openssl-rand-base64-32

# Email — Resend (candidate-facing)
RESEND_API_KEY=
EMAIL_FROM=aceintelligencejobs <noreply@aceintelligence.systems>

# Email — Gmail SMTP (admin internal)
GMAIL_USER=
GMAIL_PASS=

# Email — Contact form
GMAIL_SMTP_PASS=
GMAIL_SMTP_EMAIL=

# Client URL (for email verification links)
# Local: http://localhost:3000 | Production: https://aceintelligence.systems
CLIENT_URL=http://localhost:3000

# Public
NEXT_PUBLIC_CAREERS_FORM_URL=
