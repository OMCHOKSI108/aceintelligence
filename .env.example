# Botpress Webchat Configuration
# Get these from Botpress Dashboard → Webchat → Deploy Settings

NEXT_PUBLIC_BOTPRESS_INJECT_URL=https://cdn.botpress.cloud/webchat/vX.X/inject.js
NEXT_PUBLIC_BOTPRESS_CONFIG_URL=https://files.bpcontent.cloud/XXXXX/config.js

# Botpress CLI Authentication (for local development)
BOTPRESS_TOKEN=
BOTPRESS_WORKSPACE_ID=
BOTPRESS_BOT_ID=

# Careers - Talent Pool Form URL (e.g. Google Form, Tally, etc.)
# If empty, falls back to mailto:contact@aceintelligence.systems
NEXT_PUBLIC_CAREERS_FORM_URL=
